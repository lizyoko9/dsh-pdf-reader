{
  "name": "dsh-pdf-reader",
  "version": "0.2.4",
  "description": "Practical PDF reading for DeepSeek Harness: full-text search, annotations, AI translation/explanation and quotes",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/reader.js",
    "client.js",
    "assets/pdf_search.py",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "reader"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
